{
  "name": "eslint",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "type-check": "cd backend && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "prepare": "husky"
  },
  "lint-staged": {
    "backend/src/**/*.ts": [
      "eslint --fix --max-warnings=0",
      "prettier --write",
      "bash -c 'cd backend && tsc --noEmit --strict' || exit 1"
    ],
    "frontend/js/**/*.js": [
      "eslint --fix --max-warnings=0 --config frontend/eslint.config.js",
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.1",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "typedoc": "^0.28.4",
    "typescript-eslint": "^8.32.1"
  }
}
